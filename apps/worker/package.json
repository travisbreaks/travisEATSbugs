{
  "name": "@travisbreaks/travisEATSbugs-worker",
  "version": "0.0.1-alpha.0",
  "description": "Cloudflare Worker hosting the default travisEATSbugs backend at eats.travisfixes.com.",
  "license": "Apache-2.0",
  "author": "Travis Bonnet <travisbonnet@gmail.com>",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply travisEATSbugs --local",
    "migrate:remote": "wrangler d1 migrations apply travisEATSbugs --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src"
  },
  "dependencies": {
    "@travisbreaks/travisEATSbugs": "workspace:*",
    "@travisbreaks/travisEATSbugs-cloudflare": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@cloudflare/workers-types": "^4.20260520.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^25.9.1",
    "better-sqlite3": "^12.10.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.93.0"
  }
}
